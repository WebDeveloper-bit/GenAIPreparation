   "source": [
    "class Robot:\n",
    "    def __init__(self, name, model):\n",
    "        self.name = name\n",
    "        self.model = model\n",
    "\n",
    "    def greet(self):\n",
    "        return f\"Hello, I am {self.name}, a {self.model} robot.\"\n",
    "\n",
    "Robot1 = Robot(\"Robo1\", \"Alpha\")\n",
    "Robot1.greet()"
   ]
